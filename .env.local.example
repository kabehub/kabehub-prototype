# ============================================================
# KabeHub 環境変数サンプル
# ============================================================
# このファイルをコピーして .env.local にリネームしてください。
# cp .env.local.example .env.local
#
# ⚠️ .env.local は絶対にGitにコミットしないでください。
#    （.gitignore に含まれています）
# ============================================================

# ------------------------------------------------------------
# Supabase（必須）
# Supabaseダッシュボード → Project Settings → API から取得
# ------------------------------------------------------------
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key

# ------------------------------------------------------------
# Supabase Service Role Key
# MCP認証・通報機能(submit_report)・GitHub連携トークン管理・
# チャット保存失敗時のフォールバックで使用します。
# これらを含む本番フル機能運用では必須です。
# ⚠️ server-only。NEXT_PUBLIC_ を付けないでください。
# ------------------------------------------------------------
SUPABASE_SERVICE_ROLE_KEY=

# ------------------------------------------------------------
# AIのAPIキーについて
# APIキーはブラウザの設定ドロワーから入力し、request header
# （x-anthropic-api-key等）経由で各API Routeへ送信する方式です。
# server環境変数としては使用しないため、.env.local への設定項目は
# ありません。
# ------------------------------------------------------------

# ------------------------------------------------------------
# GitHub連携（GitHub連携機能を使う場合のみ必須）
# ------------------------------------------------------------

# GitHub OAuth App の Client ID
GITHUB_CLIENT_ID=

# GitHub OAuth App の Client Secret
# ⚠️ server-only。NEXT_PUBLIC_ を付けないでください。
GITHUB_CLIENT_SECRET=

# GitHub OAuth のコールバックURL
# 例: https://your-domain.com/api/auth/github/callback
GITHUB_REDIRECT_URI=

# GitHubアクセストークン暗号化用の鍵（64桁hex文字列必須）
# ⚠️ server-only。NEXT_PUBLIC_ を付けないでください。
GITHUB_TOKEN_ENCRYPTION_KEY=

# ------------------------------------------------------------
# Upstash Redis（レート制限機能を使う場合のみ必須・それ以外は任意）
# 未設定の場合はレート制限なしでアプリは動作を継続します（fail-open）。
# ------------------------------------------------------------
UPSTASH_REDIS_REST_URL=

# ⚠️ server-only。NEXT_PUBLIC_ を付けないでください。
UPSTASH_REDIS_REST_TOKEN=

# ------------------------------------------------------------
# デプロイ環境
# ------------------------------------------------------------

# Arena共有ページ（app/arena/[token]/page.tsx）がサーバー側から
# 自サイトのAPI（/api/share/[token]）を呼び出す際のベースURL。
# 未設定時は、Vercelでは VERCEL_URL、それ以外では
# http://localhost:3000 へ自動フォールバックします。
# 自己fetch先を固定したい場合（カスタムドメイン運用時など）に設定してください。
NEXT_PUBLIC_SITE_URL=
